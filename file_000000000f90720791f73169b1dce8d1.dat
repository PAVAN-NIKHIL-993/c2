<table>
  <tr><th>Turns</th><th>OD (cm)</th><th>ID (cm)</th><th>L (μH)</th><th>C for 1 MHz</th><th>Q (est.)</th><th>Max Power</th></tr>
  <tr><td><b>10 T</b></td><td><b>5</b></td><td>~2</td><td><b>~5–7</b></td><td><b>4700–5600 pF</b></td><td>~80</td><td>12 W ✅</td></tr>
  <tr><td>10 T</td><td>7</td><td>~3</td><td>~10–13</td><td>2200–3300 pF</td><td>~90</td><td>12 W ✅</td></tr>
